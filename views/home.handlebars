<div class="home-container">

    <!-- HERO -->

    <section class="hero">

        <div class="hero-content">

            <h1>
                Todo lo que necesitas,
                en un solo lugar.
            </h1>

            {{#if usuario}}

                <p>
                    Bienvenido nuevamente, {{usuario.nombre}}.
                    Explora nuestro catalogo y encuentra lo que necesitas.
                </p>

            {{else}}

                <p>
                    Descubre productos, compra de forma sencilla
                    y administra tus pedidos desde cualquier lugar.
                </p>

            {{/if}}

            <a href="/productos" class="hero-button">
                <i class="bi bi-shop"></i>
                Explorar catalogo
            </a>

        </div>

        <i class="bi bi-cart3 hero-icon"></i>

    </section>


    <!-- TARJETAS -->

    <section class="features">

        <div class="row g-4">

            <!-- CATALOGO -->

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-grid"></i>
                    </div>

                    <h3>Catalogo</h3>

                    <p>
                        Explora todos nuestros productos
                        disponibles y encuentra lo que buscas.
                    </p>

                    <a href="/productos" class="btn btn-outline-primary">
                        Ver productos
                    </a>

                </div>

            </div>


            {{#if usuario}}

                <!-- CARRITO -->

                <div class="col-md-4">

                    <div class="feature-card">

                        <div class="feature-icon">
                            <i class="bi bi-cart3"></i>
                        </div>

                        <h3>Mi carrito</h3>

                        <p>
                            Revisa los productos que has agregado
                            y prepara tu compra.
                        </p>

                        <a href="/carrito" class="btn btn-outline-primary">
                            Ver carrito
                        </a>

                    </div>

                </div>


                <!-- PEDIDOS -->

                <div class="col-md-4">

                    <div class="feature-card">

                        <div class="feature-icon">
                            <i class="bi bi-box-seam"></i>
                        </div>

                        <h3>Mis pedidos</h3>

                        <p>
                            Consulta tus compras anteriores
                            y revisa su estado.
                        </p>

                        <a href="/cliente/pedidos" class="btn btn-outline-primary">
                            Ver pedidos
                        </a>

                    </div>

                </div>

            {{else}}

                <!-- LOGIN -->

                <div class="col-md-4">

                    <div class="feature-card">

                        <div class="feature-icon">
                            <i class="bi bi-person"></i>
                        </div>

                        <h3>Iniciar sesion</h3>

                        <p>
                            Accede a tu cuenta para realizar
                            compras y administrar tus pedidos.
                        </p>

                        <a href="/auth/login" class="btn btn-outline-primary">
                            Ingresar
                        </a>

                    </div>

                </div>


                <!-- REGISTRO -->

                <div class="col-md-4">

                    <div class="feature-card">

                        <div class="feature-icon">
                            <i class="bi bi-person-plus"></i>
                        </div>

                        <h3>Crear cuenta</h3>

                        <p>
                            Registrate para comenzar a comprar
                            en MarketGo.
                        </p>

                        <a href="/auth/register" class="btn btn-outline-primary">
                            Registrarse
                        </a>

                    </div>

                </div>

            {{/if}}

        </div>

    </section>


    <!-- INFORMACION -->

    <section class="info-section">

        <i class="bi bi-shield-check"></i>

        Compra de forma segura utilizando
        Firebase Authentication y nuestro sistema de pedidos.

    </section>

</div>