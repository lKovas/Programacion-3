<div class="auth-page">

    <div class="auth-container auth-login-container">

        <div class="auth-card">

            <!-- LOGO -->
            <div class="auth-brand">

                <div class="auth-brand-icon">
                    M
                </div>

                <span>MarketGo</span>

            </div>


            <!-- ENCABEZADO -->
            <div class="auth-header">

                <h1>Bienvenido de nuevo</h1>

                <p>
                    Inicia sesion para continuar en MarketGo.
                </p>

            </div>


            <!-- FORMULARIO -->
            <form id="loginForm" novalidate>

                <div class="auth-field">

                    <label for="correo">
                        Correo electronico
                    </label>

                    <input
                        type="email"
                        id="correo"
                        class="auth-input"
                        placeholder="correo@ejemplo.com"
                        autocomplete="email"
                        required
                    >

                </div>


                <div class="auth-field">

                    <label for="password">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        id="password"
                        class="auth-input"
                        placeholder="Ingresa tu contraseña"
                        autocomplete="current-password"
                        required
                    >

                </div>


                <!-- ERROR -->
                <div
                    id="loginError"
                    class="auth-error d-none"
                    role="alert"
                ></div>


                <!-- BOTON -->
                <button
                    type="submit"
                    id="loginBtn"
                    class="auth-button"
                >
                    Iniciar sesion
                </button>

            </form>


            <!-- FOOTER -->
            <div class="auth-footer">

                <span>
                    ¿No tienes una cuenta?
                </span>

                <a href="/auth/register">
                    Crear cuenta
                </a>

            </div>

        </div>

    </div>

</div>


<script type="module">

    import {
        auth,
        signInWithEmailAndPassword
    } from "/js/firebaseClient.js";


    const form = document.getElementById("loginForm");
    const btn = document.getElementById("loginBtn");
    const errorBox = document.getElementById("loginError");


    function mensajeDeError(codigo) {

        switch (codigo) {

            case "auth/invalid-email":
                return "El correo electronico no tiene un formato valido.";

            case "auth/user-not-found":
            case "auth/wrong-password":
            case "auth/invalid-credential":
                return "Correo o contraseña incorrectos.";

            case "auth/too-many-requests":
                return "Demasiados intentos. Espera un momento y vuelve a intentar.";

            default:
                return "No fue posible iniciar sesion. Intenta de nuevo.";

        }

    }


    function mostrarError(texto) {

        errorBox.textContent = texto;
        errorBox.classList.remove("d-none");

    }


    function ocultarError() {

        errorBox.classList.add("d-none");

    }


    form.addEventListener("submit", async (e) => {

        e.preventDefault();

        ocultarError();


        const correo =
            document.getElementById("correo").value.trim();

        const password =
            document.getElementById("password").value;


        btn.disabled = true;
        btn.textContent = "Ingresando...";


        try {

            // 1) Firebase valida el correo y la contraseña
            const credencial =
                await signInWithEmailAndPassword(
                    auth,
                    correo,
                    password
                );


            // 2) Obtener el token de Firebase
            const token =
                await credencial.user.getIdToken();


            // 3) Enviar el token al backend
            const respuesta =
                await fetch("/auth/verify-token", {

                    method: "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({
                        token
                    })

                });


            const resultado =
                await respuesta.json();


            if (resultado.success) {

                window.location.href =
                    resultado.redirect;

            } else {

                mostrarError(
                    resultado.message ||
                    "No fue posible iniciar sesion."
                );

            }


        } catch (error) {

            console.error(error);

            mostrarError(
                mensajeDeError(error.code)
            );

        } finally {

            btn.disabled = false;
            btn.textContent = "Iniciar sesion";

        }

    });

</script>