<!--
    Autentica con Firebase en el navegador y luego avisa a
    nuestro propio backend (POST /auth/verify-token) para que
    cree la sesión del servidor (req.session.usuario).
 
-->
<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow">

                <div class="card-header text-center">
                    <h2>Inicio de sesión</h2>
                </div>

                <div class="card-body">

                    <!--
                        No lleva action/method: el envío se
                        controla 100% desde el script de abajo
                        (fetch), para poder mostrar mensajes de
                        error sin recargar la página.
                    -->
                    <form id="loginForm" novalidate>

                        <div class="mb-3">

                            <label class="form-label">
                                Correo electrónico
                            </label>

                            <input
                                type="email"
                                id="correo"
                                class="form-control"
                                autocomplete="email"
                                required
                            >
                            
                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Contraseña
                            </label>
                            
                            <input
                                type="password"
                                id="password"
                                class="form-control"
                                autocomplete="current-password"
                                required
                            >

                        </div>

                        <!--
                            Espacio reservado para mostrar errores.
                            Antes se usaba alert(), que es molesto y
                            bloquea el navegador. Ahora el mensaje
                            aparece dentro de la misma tarjeta.
                        -->
                        <div id="loginError" class="alert alert-danger d-none" role="alert"></div>

                        <button
                            type="submit"
                            id="loginBtn"
                            class="btn btn-primary w-100"
                        >
                            Iniciar sesión
                        </button>

                    </form>

                </div>

                <div class="card-footer text-center">
                    
                    ¿No tienes una cuenta?

                    <a href="/auth/register">
                    
                        Registrarse
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<script type="module">


    import {
        auth,
        signInWithEmailAndPassword
    } from "/js/firebaseClient.js";

    const form = document.getElementById("loginForm");
    const btn = document.getElementById("loginBtn");
    const errorBox = document.getElementById("loginError");

    // Traduce los códigos de error de Firebase a mensajes
    // entendibles para el usuario final.
    function mensajeDeError(codigo) {
        switch (codigo) {
            case "auth/invalid-email":
                return "El correo electrónico no tiene un formato válido.";
            case "auth/user-not-found":
            case "auth/wrong-password":
            case "auth/invalid-credential":
                return "Correo o contraseña incorrectos.";
            case "auth/too-many-requests":
                return "Demasiados intentos. Espera un momento y vuelve a intentar.";
            default:
                return "No fue posible iniciar sesión. Intenta de nuevo.";
        }
    }

    function mostrarError(texto) {
        errorBox.textContent = texto;
        errorBox.classList.remove("d-none");
    }

    function ocultarError() {
        errorBox.classList.add("d-none");
    }

    form.addEventListener("submit", async (e) => {

        e.preventDefault();
        ocultarError();

        const correo = document.getElementById("correo").value.trim();
        const password = document.getElementById("password").value;

        // Deshabilitamos el botón mientras se procesa la petición
        // para evitar que el usuario haga doble clic y se disparen
        // dos inicios de sesión al mismo tiempo.
        btn.disabled = true;
        btn.textContent = "Ingresando...";

        try {

            // 1) Firebase valida el correo y la contraseña
            const credencial = await signInWithEmailAndPassword(auth, correo, password);

            // 2) Obtenemos el token que identifica a este usuario
            const token = await credencial.user.getIdToken();

            // 3) Se lo mandamos a NUESTRO backend para crear la sesión
            const respuesta = await fetch("/auth/verify-token", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ token })
            });

            const resultado = await respuesta.json();

            if (resultado.success) {
                window.location.href = resultado.redirect;
            } else {
                mostrarError(resultado.message || "No fue posible iniciar sesión.");
            }


        } catch (error) {

            console.error(error);
            mostrarError(mensajeDeError(error.code));
        } finally {
            btn.disabled = false;
            btn.textContent = "Iniciar sesión";
        }

    });

</script>
