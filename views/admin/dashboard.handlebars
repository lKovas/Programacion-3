<div class="container my-5">

    <!-- Encabezado -->
    <div class="mb-5">
        <h1 class="fw-bold mb-2">Panel de Administracion</h1>
        <p class="text-muted mb-0">
            Gestiona los productos, categorias y pedidos de MarketGo.
        </p>
    </div>


    <!-- Acciones principales -->
    <div class="row g-4">

        <!-- Productos -->
        <div class="col-md-4">

            <div class="admin-card h-100">

                <div class="admin-card-icon products-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <h4>Productos</h4>

                <p>
                    Administra el catalogo de productos,
                    precios y existencias.
                </p>

                <a href="/admin/productos" class="admin-card-button">
                    Gestionar productos
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>


        <!-- Categorias -->
        <div class="col-md-4">

            <div class="admin-card h-100">

                <div class="admin-card-icon categories-icon">
                    <i class="bi bi-tags"></i>
                </div>

                <h4>Categorias</h4>

                <p>
                    Crea, modifica y organiza las
                    categorias del catalogo.
                </p>

                <a href="/admin/categorias" class="admin-card-button">
                    Gestionar categorias
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>


        <!-- Pedidos -->
        <div class="col-md-4">

            <div class="admin-card h-100">

                <div class="admin-card-icon orders-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <h4>Pedidos</h4>

                <p>
                    Consulta los pedidos realizados y
                    actualiza su estado.
                </p>

                <a href="/admin/pedidos" class="admin-card-button">
                    Gestionar pedidos
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

    </div>


    <!-- Acciones rapidas -->
    <div class="admin-section mt-5">

        <div class="section-header">

            <div>
                <h3>Acciones rapidas</h3>
                <p>
                    Accede rapidamente a las tareas mas utilizadas.
                </p>
            </div>

        </div>


        <div class="row g-3">

            <div class="col-md-4">

                <a href="/admin/productos/nuevo" class="quick-action">

                    <i class="bi bi-plus-circle"></i>

                    <div>
                        <strong>Nuevo producto</strong>
                        <span>Agregar producto al catalogo</span>
                    </div>

                </a>

            </div>


            <div class="col-md-4">

                <a href="/admin/categorias/nueva" class="quick-action">

                    <i class="bi bi-folder-plus"></i>

                    <div>
                        <strong>Nueva categoria</strong>
                        <span>Crear una categoria</span>
                    </div>

                </a>

            </div>


            <div class="col-md-4">

                <a href="/admin/pedidos" class="quick-action">

                    <i class="bi bi-clipboard-check"></i>

                    <div>
                        <strong>Revisar pedidos</strong>
                        <span>Consultar pedidos recientes</span>
                    </div>

                </a>

            </div>

        </div>

    </div>

</div>