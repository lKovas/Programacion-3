<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Categorias</h1>
            <p class="text-muted mb-0">
                Administra las categorias de productos.
            </p>
        </div>

        <a href="/admin/categorias/nueva" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Nueva categoria
        </a>

    </div>


    {{#if categorias}}

        <div class="admin-table-container">

            <div class="table-responsive">

                <table class="table admin-table align-middle mb-0">

                    <thead>

                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripcion</th>
                            <th class="text-end">Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        {{#each categorias}}

                            <tr>

                                <td>
                                    <span class="id-badge">
                                        {{this.idcategoria}}
                                    </span>
                                </td>

                                <td>
                                    <strong>{{this.nombre}}</strong>
                                </td>

                                <td>
                                    {{#if this.descripcion}}
                                        <span class="text-muted">
                                            {{this.descripcion}}
                                        </span>
                                    {{else}}
                                        <span class="text-muted">
                                            Sin descripcion
                                        </span>
                                    {{/if}}
                                </td>

                                <td class="text-end">

                                    <div class="admin-actions">

                                        <a
                                            href="/admin/categorias/{{this.idcategoria}}/editar"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Editar"
                                        >
                                            <i class="bi bi-pencil"></i>
                                        </a>


                                        <form
                                            action="/admin/categorias/{{this.idcategoria}}/eliminar"
                                            method="POST"
                                            class="d-inline"
                                            onsubmit="return confirm('¿Estas seguro de eliminar esta categoria?')"
                                        >

                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Eliminar"
                                            >
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        {{/each}}

                    </tbody>

                </table>

            </div>

        </div>

    {{else}}

        <div class="admin-empty-state">

            <div class="admin-empty-icon">
                <i class="bi bi-tags"></i>
            </div>

            <h4>No hay categorias</h4>

            <p>
                Todavia no existen categorias registradas.
            </p>

            <a href="/admin/categorias/nueva" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                Crear primera categoria
            </a>

        </div>

    {{/if}}

</div>