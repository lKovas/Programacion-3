<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Productos</h1>
            <p class="text-muted mb-0">
                Administra el catalogo de productos de MarketGo.
            </p>
        </div>

        <a href="/admin/productos/nuevo" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Nuevo producto
        </a>

    </div>


    <div class="admin-table-container">

        <div class="table-responsive">

            <table class="table admin-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Producto</th>
                        <th>Categoria</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    {{#each productos}}

                    <tr>

                        <td>
                            <span class="product-id">
                                #{{this.idproducto}}
                            </span>
                        </td>

                        <td>
                            <div class="product-name">
                                {{this.nombre}}
                            </div>
                        </td>

                        <td>
                            <span class="category-badge">
                                {{this.nombrecategoria}}
                            </span>
                        </td>

                        <td>
                            <strong>
                                ₡ {{this.precio}}
                            </strong>
                        </td>

                        <td>

                            {{#if this.stock}}

                                <span class="stock-badge stock-available">
                                    {{this.stock}} disponibles
                                </span>

                            {{else}}

                                <span class="stock-badge stock-empty">
                                    Agotado
                                </span>

                            {{/if}}

                        </td>

                        <td class="text-end">

                            <div class="d-flex justify-content-end gap-2">

                                <a
                                    href="/admin/productos/{{this.idproducto}}/editar"
                                    class="btn btn-sm btn-outline-primary"
                                    title="Editar"
                                >
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <form
                                    action="/admin/productos/{{this.idproducto}}/eliminar"
                                    method="POST"
                                    class="d-inline"
                                >

                                    <button
                                        type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        title="Eliminar"
                                        onclick="return confirm('¿Estas seguro de eliminar este producto?')"
                                    >
                                        <i class="bi bi-trash"></i>
                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>

                    {{else}}

                    <tr>

                        <td colspan="6" class="text-center py-5">

                            <div class="empty-state">

                                <i class="bi bi-box-seam"></i>

                                <h5>No hay productos</h5>

                                <p>
                                    Todavia no hay productos registrados.
                                </p>

                                <a
                                    href="/admin/productos/nuevo"
                                    class="btn btn-primary"
                                >
                                    Crear primer producto
                                </a>

                            </div>

                        </td>

                    </tr>

                    {{/each}}

                </tbody>

            </table>

        </div>

    </div>

</div>