<div class="container mt-5">

    <div class="row mb-4">

        <div class="col-md-8">

            <h2>Catálogo de Productos</h2>

        </div>

        <div class="col-md-4 text-end">

            <a href="/carrito" class="btn btn-success">

                <i class="bi bi-cart"></i>

                Carrito

            </a>

        </div>

    </div>

    <div class="row mb-4">

        <div class="col-md-6">

            <input
                type="text"
                id="buscar"
                class="form-control"
                placeholder="Buscar producto..."
            >

        </div>

        <div class="col-md-6">

            <select
                id="categoria"
                class="form-select"
            >

                <option value="">

                    Todas las categorías

                </option>

                {{#each categorias}}

                <option value="{{idcategoria}}">

                    {{nombre}}

                </option>

                {{/each}}

            </select>

        </div>

    </div>

    <div class="row" id="listaProductos">

        {{#each productos}}

        <div
            class="col-md-4 mb-4 producto"
            data-categoria="{{idcategoria}}"
            data-nombre="{{nombre}}"
        >

            <div class="card shadow h-100">

                <img
                    src="{{imagen}}"
                    class="card-img-top"
                    style="height:250px;object-fit:cover;"
                    alt="{{nombre}}"
                >

                <div class="card-body">

                    <h4>{{nombre}}</h4>

                    <p>

                        <strong>Categoría:</strong>

                        {{nombrecategoria}}

                    </p>

                    <p>

                        <strong>Precio:</strong>

                        ₡ {{precio}}

                    </p>

                    <p>

                        <strong>Stock:</strong>

                        {{stock}}

                    </p>

                </div>

                <div class="card-footer">

                    <a
                        href="/productos/{{idproducto}}"
                        class="btn btn-primary w-100 mb-2"
                    >

                        Ver Detalle

                    </a>

                    <form
                        action="/carrito/agregar"
                        method="POST"
                    >

                        <input
                            type="hidden"
                            name="idProducto"
                            value="{{idproducto}}"
                        >

                        <input
                            type="hidden"
                            name="cantidad"
                            value="1"
                        >

                        <button
                            type="submit"
                            class="btn btn-success w-100"
                        >

                            Agregar al carrito

                        </button>

                    </form>

                </div>

            </div>

        </div>

        {{/each}}

    </div>

</div>

<script>

const txtBuscar = document.getElementById("buscar");
const cboCategoria = document.getElementById("categoria");

function filtrar(){

    const texto = txtBuscar.value.toLowerCase();
    const categoria = cboCategoria.value;

    const productos = document.querySelectorAll(".producto");

    productos.forEach(producto=>{

        const nombre = producto.dataset.nombre.toLowerCase();
        const cat = producto.dataset.categoria;

        let mostrar = true;

        if(texto!="" && !nombre.includes(texto)){
            mostrar = false;
        }

        if(categoria!="" && categoria!=cat){
            mostrar = false;
        }

        producto.style.display = mostrar ? "" : "none";

    });

}

txtBuscar.addEventListener("keyup",filtrar);

cboCategoria.addEventListener("change",filtrar);

</script>