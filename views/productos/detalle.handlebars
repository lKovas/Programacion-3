<!--
    VISTA: Detalle de producto
-->

<div class="container producto-detalle">

    <div class="detalle-card">

        <div class="row g-0">

            <!-- IMAGEN -->
            <div class="col-lg-6">

                <div class="detalle-imagen-container">

                    <img
                        src="{{producto.imagen}}"
                        class="detalle-imagen"
                        alt="{{producto.nombre}}"
                    >

                </div>

            </div>


            <!-- INFORMACION -->
            <div class="col-lg-6">

                <div class="detalle-info">

                    <span class="detalle-categoria">
                        {{producto.nombrecategoria}}
                    </span>


                    <h1 class="detalle-titulo">
                        {{producto.nombre}}
                    </h1>


                    <hr class="detalle-separador">


                    <div class="detalle-precio">
                        ₡ {{producto.precio}}
                    </div>


                    <div class="detalle-stock">

                        <strong>Disponibilidad:</strong>

                        {{#if producto.stock}}

                            <span class="badge bg-success">
                                {{producto.stock}} disponibles
                            </span>

                        {{else}}

                            <span class="badge bg-danger">
                                Agotado
                            </span>

                        {{/if}}

                    </div>


                    {{#if producto.descripcion}}

                        <div class="detalle-descripcion">

                            <strong>Descripcion</strong>

                            <p>
                                {{producto.descripcion}}
                            </p>

                        </div>

                    {{/if}}


                    {{#if producto.stock}}

                        {{#if usuario}}

                            <form
                                action="/carrito/agregar"
                                method="POST"
                                class="detalle-form"
                            >

                                <input
                                    type="hidden"
                                    name="idProducto"
                                    value="{{producto.idproducto}}"
                                >


                                <div class="mb-3">

                                    <label
                                        for="cantidad"
                                        class="form-label"
                                    >
                                        Cantidad
                                    </label>

                                    <input
                                        type="number"
                                        id="cantidad"
                                        class="form-control"
                                        name="cantidad"
                                        value="1"
                                        min="1"
                                        max="{{producto.stock}}"
                                        required
                                    >

                                </div>


                                <div class="detalle-acciones">

                                    <button
                                        type="submit"
                                        class="btn btn-success"
                                    >
                                        <i class="bi bi-cart-plus"></i>
                                        Agregar al carrito
                                    </button>


                                    <a
                                        href="/productos"
                                        class="btn btn-outline-secondary"
                                    >
                                        Volver al catalogo
                                    </a>

                                </div>

                            </form>

                        {{else}}

                            <div class="detalle-login-alert">

                                Debes
                                <a href="/auth/login">
                                    iniciar sesion
                                </a>
                                para agregar productos al carrito.

                            </div>


                            <div class="detalle-acciones">

                                <a
                                    href="/productos"
                                    class="btn btn-outline-secondary"
                                >
                                    Volver al catalogo
                                </a>

                            </div>

                        {{/if}}

                    {{else}}

                        <div class="detalle-acciones">

                            <button
                                type="button"
                                class="btn btn-secondary"
                                disabled
                            >
                                Producto agotado
                            </button>


                            <a
                                href="/productos"
                                class="btn btn-outline-secondary"
                            >
                                Volver al catalogo
                            </a>

                        </div>

                    {{/if}}

                </div>

            </div>

        </div>

    </div>


    {{#if usuario}}

        <div class="text-center mt-4">

            <a
                href="/carrito"
                class="btn btn-primary"
            >
                <i class="bi bi-cart"></i>
                Ver carrito
            </a>

        </div>

    {{/if}}

</div>