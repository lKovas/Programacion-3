<div class="container mt-5">

    <div class="row">

        <div class="col-md-12">

            <h2 class="mb-4">

                Mi Carrito

            </h2>

        </div>

    </div>

    {{#if items.length}}

    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">

            <tr>

                <th>Producto</th>

                <th>Imagen</th>

                <th>Precio</th>

                <th>Cantidad</th>

                <th>Subtotal</th>

                <th>Acciones</th>

            </tr>

        </thead>

        <tbody>

            {{#each items}}

            <tr>

                <td>

                    {{nombre}}

                </td>

                <td>

                    <img
                        src="{{imagen}}"
                        width="80"
                        class="img-thumbnail"
                    >

                </td>

                <td>

                    ₡ {{precio}}

                </td>

                <td>

                    <form
                        action="/carrito/actualizar/{{iddetalle}}"
                        method="POST"
                        class="d-flex"
                    >

                        <input
                            type="number"
                            name="cantidad"
                            value="{{cantidad}}"
                            min="1"
                            class="form-control me-2"
                            style="width:90px;"
                        >

                        <button
                            class="btn btn-primary"
                            type="submit"
                        >

                            Actualizar

                        </button>

                    </form>

                </td>

                <td>

                    ₡ {{precio}} × {{cantidad}}

                </td>

                <td>

                    <form
                        action="/carrito/eliminar/{{iddetalle}}"
                        method="POST"
                    >

                        <button
                            class="btn btn-danger"
                        >

                            Eliminar

                        </button>

                    </form>

                </td>

            </tr>

            {{/each}}

        </tbody>

    </table>

    <div class="row mt-4">

        <div class="col-md-6">

            <h3>

                Total:

                <span class="text-success">

                    ₡ {{total}}

                </span>

            </h3>

        </div>

        <div class="col-md-6 text-end">

            <a
                href="/productos"
                class="btn btn-secondary"
            >

                Seguir Comprando

            </a>

            <form
                action="/pedidos/crear"
                method="POST"
                class="d-inline"
            >

                <input
                    type="text"
                    name="direccionEntrega"
                    class="form-control mt-3 mb-3"
                    placeholder="Dirección de entrega"
                    required
                >

                <button
                    class="btn btn-success"
                >

                    Confirmar Compra

                </button>

            </form>

            <form
                action="/carrito/vaciar"
                method="POST"
                class="d-inline"
            >

                <button
                    class="btn btn-danger"
                >

                    Vaciar Carrito

                </button>

            </form>

        </div>

    </div>

    {{else}}

    <div class="alert alert-info">

        <h4>

            Tu carrito está vacío.

        </h4>

        <a
            href="/productos"
            class="btn btn-primary mt-3"
        >

            Ir al Catálogo

        </a>

    </div>

    {{/if}}

</div>