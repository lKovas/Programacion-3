
<footer class="bg-dark text-white mt-5">

    <div class="container py-4">

        <div class="row">

            <!-- Columna 1: descripción corta de la tienda -->
            <div class="col-md-6">
                <h5>MarketGo</h5>
                <p>
                    Tienda en línea donde puedes consultar
                    productos y realizar tus compras de
                    manera sencilla.
                </p>
            </div>

            <!-- Columna 2: navegación -->
            <div class="col-md-3">
                <h5>Navegación</h5>
                <ul class="list-unstyled">

                    <li class="mb-2">
                        <a href="/productos" class="text-white text-decoration-none">
                            Inicio / Catálogo
                        </a>
                    </li>

                    <!-- Igual que en el navbar: solo con sesión activa -->
                    {{#if usuario}}

                        <li class="mb-2">
                            <a href="/carrito" class="text-white text-decoration-none">
                                Carrito
                            </a>
                        </li>

                        <li class="mb-2">
                            <a href="/cliente/pedidos" class="text-white text-decoration-none">
                                Mis pedidos
                            </a>
                        </li>

                    {{/if}}

                </ul>
            </div>

            <!-- Columna 3: cuenta -->
            <div class="col-md-3">
                <h5>Cuenta</h5>
                <ul class="list-unstyled">

                    {{#if usuario}}

                        <li class="mb-2">
                            <a href="/cliente/perfil" class="text-white text-decoration-none">
                                Mi perfil
                            </a>
                        </li>

                        <li class="mb-2">
                            <a href="/auth/logout" class="text-white text-decoration-none">
                                Cerrar sesión
                            </a>
                        </li>

                    {{else}}

                        <li class="mb-2">
                            <a href="/auth/login" class="text-white text-decoration-none">
                                Iniciar sesión
                            </a>
                        </li>

                        <li class="mb-2">
                            <a href="/auth/register" class="text-white text-decoration-none">
                                Registrarse
                            </a>
                        </li>

                    {{/if}}

                </ul>
            </div>

        </div>

        <hr>

       
        <div class="text-center">
            <p class="mb-0">
                © <span id="anioActual"></span> MarketGo. Todos los derechos reservados.
            </p>
        </div>

    </div>

</footer>

<script>
    // Coloca el año actual del sistema del usuario en el <span> de arriba.
    document.getElementById('anioActual').textContent = new Date().getFullYear();
</script>
