<div class="container my-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <div
                            class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3"
                            style="width: 80px; height: 80px; font-size: 32px;"
                        >
                            {{cliente.nombre.[0]}}
                        </div>

                        <h2 class="mb-1">
                            Mi perfil
                        </h2>

                        <p class="text-muted mb-0">
                            Administra tu informacion personal
                        </p>

                    </div>


                    <form
                        action="/cliente/perfil"
                        method="POST"
                    >

                        <!-- NOMBRE -->

                        <div class="mb-3">

                            <label
                                for="nombre"
                                class="form-label"
                            >
                                Nombre completo
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="nombre"
                                name="nombre"
                                value="{{cliente.nombre}}"
                                required
                            >

                        </div>


                        <!-- CORREO -->

                        <div class="mb-3">

                            <label
                                for="correo"
                                class="form-label"
                            >
                                Correo electronico
                            </label>

                            <input
                                type="email"
                                class="form-control"
                                id="correo"
                                value="{{cliente.correo}}"
                                disabled
                            >

                            <div class="form-text">
                                El correo es administrado por Firebase Authentication.
                            </div>

                        </div>


                        <!-- TELEFONO -->

                        <div class="mb-3">

                            <label
                                for="telefono"
                                class="form-label"
                            >
                                Telefono
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="telefono"
                                name="telefono"
                                value="{{cliente.telefono}}"
                            >

                        </div>


                        <!-- DIRECCION -->

                        <div class="mb-4">

                            <label
                                for="direccion"
                                class="form-label"
                            >
                                Direccion
                            </label>

                            <textarea
                                class="form-control"
                                id="direccion"
                                name="direccion"
                                rows="3"
                            >{{cliente.direccion}}</textarea>

                        </div>


                        <!-- BOTONES -->

                        <div class="d-flex justify-content-between">

                            <a
                                href="/productos"
                                class="btn btn-secondary"
                            >
                                Volver al catalogo
                            </a>

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                Guardar cambios
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>